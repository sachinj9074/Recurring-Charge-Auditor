# Copy this file to .env and paste your own key. Never commit .env.

# Anthropic API key (you paste your own)
ANTHROPIC_API_KEY=paste-your-key-here

# Model tiers. Swappable; src/model.py is the source of truth.
FAST_MODEL=claude-sonnet-5
JUDGMENT_MODEL=claude-opus-4-8

# Real mode is multi-user: each person creates their own account in the app, and
# their derived charge list is encrypted with their password. No per-account env
# vars are needed.

# Durable storage for real accounts. Leave the R2 vars blank to store locally (a
# private, encrypted archive under local_records/cloud/ on this machine). Set them
# on a hosted deploy so data persists: create a Cloudflare R2 bucket and an S3 API
# token, then fill these in (keep them out of git).
R2_BUCKET=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cost-safety (enrichment spends the operator's API budget). The public demo leads
# with zero-cost pre-baked runs; DEMO_LIVE_UPLOADS caps live "try your own file"
# trials per browser session. REAL_STATEMENTS_PER_DAY caps statements one real
# account may process per day.
DEMO_LIVE_UPLOADS=2
REAL_STATEMENTS_PER_DAY=10

# Shared invite code for "Use it for real". Leave blank for no gate (local use).
# Set it on a public deploy so only people you give the code to can create an
# account or sign in, keeping unknown visitors off your API key. Rotate by changing
# this value. Each user still has their own personal account password.
REAL_ACCESS_CODE=
